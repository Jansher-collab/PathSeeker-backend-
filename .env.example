# ==============================================================
# PATHSEEKER BACKEND CONFIGURATION
# Copy this file to .env and fill in your actual values.
# DO NOT commit real secrets to source control.
# ==============================================================

# --------------------------
# Server & Environment
# --------------------------
PORT=5000
NODE_ENV=development

# --------------------------
# Client URL
# --------------------------
# Determines where generated emails link to (e.g. password resets).
# Must match the frontend's deployed URL.
FRONTEND_URL=http://localhost:3000

# --------------------------
# Database Integration
# --------------------------
# The primary MongoDB connection string. 
# If provided, the system enforces STRICT database writes and will not mock data.
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/pathseeker?retryWrites=true&w=majority

# --------------------------
# Authentication Security
# --------------------------
# Secret key used to sign JSON Web Tokens. Must be kept private.
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# --------------------------
# Email & SMTP Integration (Nodemailer)
# --------------------------
# Used for Registration, Password Recovery, and Form Submissions.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# Provide real credentials to enable live email dispatch. 
# If left as placeholders, the system safely logs emails to console.
SMTP_USER=your-email-address@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=PathSeeker Support <your-email-address@gmail.com>

# --------------------------
# Admin Notifications
# --------------------------
# Email address where admin/support notifications (e.g. user feedback) are sent.
ADMIN_EMAIL=admin@your-domain.com
